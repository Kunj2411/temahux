{
  "name": "temahux-monorepo",
  "private": true,
  "scripts": {
    "dev:main": "npm --prefix apps/main run dev",
    "dev:services": "npm --prefix apps/services run dev",
    "dev:academy": "npm --prefix apps/academy run dev",
    "build:main": "npm --prefix apps/main run build",
    "build:services": "npm --prefix apps/services run build",
    "build:academy": "npm --prefix apps/academy run build",
    "build:all": "npm run build:main && npm run build:services && npm run build:academy"
  }
}
